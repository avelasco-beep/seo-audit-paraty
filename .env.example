# Copia este archivo a .env y rellena tus claves.
#   cp .env.example .env
#
# IMPORTANTE: .env está en .gitignore y NO se sube al repositorio.
# Los scripts leen las claves de estas variables de entorno; así el repo
# es independiente y cada persona usa las suyas.

# --- Google PageSpeed Insights (usado por scripts/psi.py) ---
# Consíguela en: https://developers.google.com/speed/docs/insights/v5/get-started
# Alternativa: psi.py también la lee de ~/.config/paraty/pagespeed.key
PAGESPEED_API_KEY=

# --- Google Search Console (usado por el MCP gscServer, ver .mcp.json.example) ---
# Ruta al JSON de credenciales OAuth descargado de Google Cloud Console.
GSC_OAUTH_CLIENT_SECRETS_FILE=
